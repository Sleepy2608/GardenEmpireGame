{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/client/welcome.html"
    },
    {
      "source": "/welcome",
      "destination": "/client/welcome.html"
    },
    {
      "source": "/welcome.html",
      "destination": "/client/welcome.html"
    },
    {
      "source": "/dashboard",
      "destination": "/client/welcome.html"
    },
    {
      "source": "/index",
      "destination": "/client/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/client/index.html"
    },
    {
      "source": "/lobby",
      "destination": "/client/lobby.html"
    },
    {
      "source": "/lobby.html",
      "destination": "/client/lobby.html"
    },
    {
      "source": "/room",
      "destination": "/client/waiting-room.html"
    },
    {
      "source": "/waiting-room",
      "destination": "/client/waiting-room.html"
    },
    {
      "source": "/waiting-room.html",
      "destination": "/client/waiting-room.html"
    },
    {
      "source": "/game",
      "destination": "/client/game.html"
    },
    {
      "source": "/game.html",
      "destination": "/client/game.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
